1 MEMORY &7FFF
2 LOAD"cterm2.bin"
3 CALL &8000
4 |TERM
5 GOTO 60000
59900 GOTO 60000
60000 ON ERROR GOTO 60900
60010 a$=SPACE$(255)
60020 |TERMIO,@a$
60030 IF a$<>"" THEN 60050
60040 FOR i=1 TO 100:NEXT:GOTO 60010
60050 c$=LEFT$(a$,1)
60060 IF c$>="0" AND c$<="9" THEN 60200
60070 IF a$="run" OR a$="RUN" THEN a$="RUN 10"
60080 IF a$="list" OR a$="LIST" THEN a$="LIST -59899"
60090 OPENOUT"cmd.bas"
60100 PRINT#9,"59990 ";a$
60110 PRINT#9,"59991 GOTO 60000"
60120 CLOSEOUT
60130 CHAIN MERGE"cmd.bas",59990
60200 OPENOUT"cmd.bas"
60210 PRINT#9,a$
60220 CLOSEOUT
60230 CHAIN MERGE"cmd.bas",60000
60900 PRINT "*** Erreur";ERR;"ligne";ERL;"***"
60910 RESUME 60000
